#!/usr/bin/env bash
#
# Onboard one checkout under the workspace root: scaffold its sandcastle
# config with the real `sandcastle init`, add this stack's extras, and build
# its image. After this, the Project can receive Dispatches. See ADR 0003.
#
# No credentials: they are the Harness's, injected into each Sandbox for the
# life of one Run (ADR 0006). A Project holds none, and this creates no
# .sandcastle/.env — a stale one would be a second, disagreeing copy of a token
# the Harness already has.
#
# Usage:
#   init-project <project>
set -euo pipefail

# readlink -f, not dirname alone: the deploy installs this as a symlink on
# PATH, and BASH_SOURCE reports the symlink rather than what it points at.
here="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
# shellcheck source=lib/common.sh
source "${here}/lib/common.sh"
usage() {
  echo "Usage: init-project <project>" >&2
  exit 1
}

[ $# -eq 1 ] || usage
project="$1"

validate_project_name "$project"
root="$(workspace_root)"
dir="${root}/${project}"

[ -d "${dir}/.git" ] || {
  echo "Project \"${project}\" is not a git checkout under ${root}" >&2
  exit 1
}

echo "==> Scaffolding .sandcastle/ in ${dir}"
# Sandcastle refuses if .sandcastle/ already exists, which is the guard against
# re-onboarding over someone's customizations — let it fail the command.
(
  cd "$dir"
  sandcastle init \
    --agent claude-code \
    --sandbox docker \
    --template blank \
    --issue-tracker github-issues \
    --create-label false \
    --build-image false \
    --install-template-deps false
)

echo "==> Appending this stack's extras to .sandcastle/Dockerfile"
repo_root="$(cd "${here}/../.." && pwd)"
cat "${repo_root}/docker/sandbox/extras.Dockerfile" >> "${dir}/.sandcastle/Dockerfile"

echo "==> Building the Project's image"
# Everything above this point has landed. Re-running init-project would now hit
# sandcastle's already-exists guard, so point at the step to retry rather than
# leaving the operator to guess that .sandcastle/ must be deleted.
if ! (cd "$dir" && sandcastle docker build-image); then
  cat >&2 << EOF

The image build failed, but ${project} is otherwise Onboarded — do not re-run
init-project. Fix .sandcastle/Dockerfile and retry just the build:

  cd ${dir} && sandcastle docker build-image

A Run against this Project would also build the image itself if it is missing.
EOF
  exit 1
fi

cat << EOF

Onboarded ${project}.

  .sandcastle/ is ready to commit. It carries no credentials — the Harness
  holds those and injects them per Run.
  Dispatch a Run with: sandcastle-run ${project} "your task"
EOF
