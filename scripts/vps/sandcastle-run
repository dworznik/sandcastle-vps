#!/usr/bin/env bash
#
# Dispatch a sandcastle Run. Keyless: posts to the Harness's /dispatch route on
# loopback — reachability is the access control, so run this on the VPS host or
# through an SSH tunnel. Non-blocking: the Run is queued by the Orchestrator;
# the run page it prints tails the Run live, and the Inngest dashboard has its
# status.
#
# Usage:
#   sandcastle-run <project> <task...> [--branch <name>] [--base <name>] [--model <model>]
set -euo pipefail

usage() {
  echo "Usage: sandcastle-run <project> <task...> [--branch <name>] [--base <name>] [--model <model>]" >&2
  exit 1
}

[ $# -ge 2 ] || usage

project="$1"
shift

branch=""
# The Base: what the Task Branch is cut from and what its pull request is
# proposed against. Left empty, the Harness resolves the Project remote's
# default branch.
base=""
model=""
task_parts=()
while [ $# -gt 0 ]; do
  case "$1" in
    --branch)
      [ $# -ge 2 ] || usage
      branch="$2"
      shift 2
      ;;
    --base)
      [ $# -ge 2 ] || usage
      base="$2"
      shift 2
      ;;
    --model)
      [ $# -ge 2 ] || usage
      model="$2"
      shift 2
      ;;
    *)
      task_parts+=("$1")
      shift
      ;;
  esac
done

[ ${#task_parts[@]} -gt 0 ] || usage
task="${task_parts[*]}"

payload="$(jq -n \
  --arg project "$project" \
  --arg task "$task" \
  --arg branch "$branch" \
  --arg base "$base" \
  --arg model "$model" \
  '{project: $project, task: $task}
   + (if $branch != "" then {branch: $branch} else {} end)
   + (if $base != "" then {base: $base} else {} end)
   + (if $model != "" then {model: $model} else {} end)')"

dispatch_urls=()
if [ -n "${SANDCASTLE_DISPATCH_URL:-}" ]; then
  dispatch_urls+=("$SANDCASTLE_DISPATCH_URL")
fi
# Compose publishes the Harness on this host's loopback and nowhere else. From
# anywhere but this host — your laptop, a container on the box — come in over
# an SSH tunnel and point SANDCASTLE_DISPATCH_URL at your end of it.
dispatch_urls+=("http://127.0.0.1:${PORT:-3000}")

# Two different failures must read differently: a harness that cannot be
# reached (try the next URL) and a harness that answered with a rejection —
# the Project is not Onboarded, the payload is malformed — which is final and
# carries the reason in its body. `curl -f` would collapse both into "failed",
# so the status is read explicitly and the body is always shown.
for url in "${dispatch_urls[@]}"; do
  response="$(curl -sS --max-time 10 -w '\n%{http_code}' -X POST "$url/dispatch" \
    -H 'content-type: application/json' -d "$payload" 2> /dev/null)" || continue
  status="${response##*$'\n'}"
  body="${response%$'\n'*}"
  case "$status" in
    2*)
      echo "Dispatched to $url: $body"
      # The run page, on the Harness's own loopback port. Through a tunnel
      # that maps the same local port it opens as printed; through one that
      # maps a different port, swap the port.
      jq -r '.logs[]? | "Run logs: \(.)"' <<< "$body" 2> /dev/null || true
      exit 0
      ;;
    *)
      echo "The harness at $url rejected the Dispatch (HTTP $status): $body" >&2
      exit 1
      ;;
  esac
done

echo "Failed to reach the sandcastle harness at: ${dispatch_urls[*]}" >&2
exit 1
