# The Target's compose environment. Written on the Target by the creator CLI's
# install, filling in what can be read off the Target itself. Never committed,
# never copied back to the operator's machine, and mode 600 — the agent's
# credentials live here.
#
# Re-running the install seeds a key that has no value and never overwrites one
# that has, so a value edited by hand survives an upgrade.

# Directory on the Target holding the Project checkouts. Mounted into the
# Harness at the same path, so a Sandbox's bind mounts resolve on the Target.
WORKSPACE_ROOT=

# Directory on the Target holding the agent's signing key, mounted read-only
# into the Harness at the same path for the same reason. Created by the install
# under the install directory, mode 700.
SECRETS_DIR=

# The operator on the Target who owns those checkouts, and the Target's docker
# group. The Harness runs as that user and joins that group, so worktrees are
# owned correctly and the mounted socket is usable. Read off the Target.
OPERATOR_UID=
OPERATOR_GID=
DOCKER_GID=

# The agent's identity. Held by the Harness and injected into each Sandbox for
# the life of one Run — no Project carries a copy (ADR 0006). Captured by the
# wizard, which is also how they are rotated; a Run names whichever of them is
# still empty rather than running unauthenticated. The key itself is not here:
# it is the file `agent_signing_key` in SECRETS_DIR above.
CLAUDE_CODE_OAUTH_TOKEN=
GH_TOKEN=
AGENT_GIT_NAME=
AGENT_GIT_EMAIL=

# Inngest server credentials. Generated on the Target by the install when
# empty.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# The two per-Target toggles (ADR 0010), which decide the Target's posture:
# `sessions` makes it a Workstation Target; `access` is independent of it.
# Seeded off by the install and flipped from the wizard's menu, never by
# hand — only the literal `true` turns one on, because enabling sessions
# exposes the Docker socket to containers built from Projects' own Dockerfiles.
SESSIONS_ENABLED=false
ACCESS_ENABLED=false

# Optional overrides.
#AGENT_MODEL=claude-opus-4-8
# The Dispatch port, published on Target loopback only. Nothing authenticates
# behind it — do not publish it anywhere else without putting auth in front.
#PORT=3000
