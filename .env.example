# VPS-side runtime config. The deploy script seeds ~/.sandcastle-vps/.env from
# this file and auto-fills host-derived values; edit the remote copy for
# machine-specific settings. Never committed.

# Directory on the VPS host containing the project checkouts (shared with the
# claude-tmux stack). Auto-filled from ~/.claude-tmux/.env when present.
HOST_WORKSPACE_ROOT=

# UID/GID owning the workspace checkouts, and the docker socket's GID.
# Auto-filled by the deploy script from the remote host.
DEV_UID=
DEV_GID=
DOCKER_GID=

# Long-lived token from `claude setup-token`, injected into every sandbox.
CLAUDE_CODE_OAUTH_TOKEN=

# Inngest server credentials. Auto-generated (openssl rand -hex 32) by the
# deploy script when left empty.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Optional overrides.
#AGENT_MODEL=claude-opus-4-8
#SANDBOX_IMAGE=sandcastle-vps-sandbox
