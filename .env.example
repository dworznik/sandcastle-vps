# VPS-side runtime config. The deploy script seeds ~/.sandcastle-vps/.env from
# this file and auto-fills what it can; edit the remote copy for
# machine-specific settings. Never committed.
#
# Read by both the Harness service (systemd EnvironmentFile) and the Onboarding
# commands, so there is one answer to "where do Projects live".

# Directory on the VPS host containing the Project checkouts (shared with the
# claude-tmux stack). Auto-filled from ~/.claude-tmux/.env when present.
WORKSPACE_ROOT=

# The harness holds no agent credentials: each Project keeps its own token in
# its .sandcastle/.env, which sandcastle reads natively. Onboard a checkout
# with `init-project <name>` and rotate tokens with `sync-env`.

# Inngest server credentials. Auto-generated (openssl rand -hex 32) by the
# deploy script when left empty.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# The Orchestrator, reached over loopback — it shares the host's network
# namespace. INNGEST_DEV=0 keeps the SDK in self-hosted mode.
INNGEST_BASE_URL=http://127.0.0.1:8288
INNGEST_DEV=0

# Optional overrides.
#AGENT_MODEL=claude-opus-4-8
# Address the Harness binds. Loopback is the access control for a keyless
# Dispatch surface — do not widen it without putting auth in front.
#HOST=127.0.0.1
#PORT=3000
