{
  "name": "@dworznik/sandcastle-vps",
  "version": "0.1.0",
  "description": "Install and run the sandcastle platform on a Target: the creator CLI, and the Harness it delivers",
  "type": "module",
  "bin": {
    "sandcastle-vps": "bin/sandcastle-vps.mjs"
  },
  "files": [
    "bin",
    "src",
    "!src/**/*.test.ts",
    "docker",
    "compose.yaml",
    ".env.example",
    "tsconfig.json",
    "pnpm-workspace.yaml"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dworznik/sandcastle-vps.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cli": "tsx src/cli/main.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint",
    "lint:type-aware": "oxlint --type-aware",
    "lint:shell": "./scripts/lint-shell.sh",
    "prepare": "git rev-parse --git-dir > /dev/null 2>&1 || exit 0; git config core.hooksPath .githooks && git config blame.ignoreRevsFile .git-blame-ignore-revs"
  },
  "dependencies": {
    "@ai-hero/sandcastle": "^0.12.0",
    "@hono/node-server": "^2.1.1",
    "@hono/zod-validator": "^0.9.1",
    "hono": "^4.13.7",
    "inngest": "^4.20.0",
    "tsx": "^4.23.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/node": "^26.1.1",
    "lint-staged": "^17.5.0",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.7.0"
}
